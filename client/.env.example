# Base URL of the API, baked into the bundle at build time (it is public).
# Development: leave as /api (Vite proxies it to the server).
# Production (Vercel): the Render URL including /api, no trailing slash, e.g.
#   VITE_API_URL=https://spendly-api.onrender.com/api
VITE_API_URL=/api
# Development only: where the Vite dev server forwards /api requests.
API_PROXY_TARGET=http://localhost:4000
