# Copy to server/.env for local development. On Render, set these in the
# service's Environment tab instead (never commit real values).

# Server port. Optional (default 4000). Render sets PORT itself; don't set it there.
PORT=4000

# PostgreSQL connection string. Required.
#   Local Postgres:  postgresql://postgres:postgres@localhost:5432/spendly
#   Neon:            postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Use Neon's direct (non-pooled) connection string: `prisma migrate deploy`
# runs with this same variable.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spendly"

# Long random string, at least 32 characters. Required.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Login token lifetime. Optional (default 7d).
JWT_EXPIRES_IN="7d"

# Frontend origin(s) allowed by CORS, comma-separated, exact match.
# Production example: "https://spendly.vercel.app,https://www.example.com"
CLIENT_ORIGIN="http://localhost:5173"

# Optional: development (default) | production | test
# NODE_ENV=production


